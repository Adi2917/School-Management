MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER_HOST/connect_your_school?retryWrites=true&w=majority
PORT=5000
CLIENT_URL=http://localhost:5173
VITE_API_URL=/api

# Private Google Sheet mirror (never expose these as VITE_ variables)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SHEET_SYNC_SECRET=
AUTH_TOKEN_SECRET=replace_with_a_different_long_random_secret_at_least_32_characters

# SMTP email used for branded student PIN reset OTPs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# One common Connect Your School mailbox is used for every school.

# Must exactly match the database name before a destructive demo reset
CONFIRM_RESET_DATABASE=connect_your_school
